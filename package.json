{
  "name": "dm-screen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A customizable, offline-first Dungeon Master screen for D&D 5e.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "node server/serve.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
